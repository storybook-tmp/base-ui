{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": false,
    "jsx": "react-jsx",
    "rootDir": "./src",
    "outDir": "build",
    "lib": ["ES2022", "DOM"],
    "types": ["@mui/internal-code-infra/build-env"],
    "paths": {
      "@base-ui/react": ["../react/build"],
      "@base-ui/react/*": ["../react/build/*"]
    }
  },
  "include": ["src/**/*.ts*"],
  "exclude": ["src/**/*.spec.ts*", "src/**/*.test.ts*"]
}
